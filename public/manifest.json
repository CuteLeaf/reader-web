{
  "manifest_version": 3,
  "name": "reader-web",
  "version": "1.0.2",
  "description": "电子书阅读器，在浏览器侧边栏导入 TXT/EPUB 文件本地离线阅读和局域网内的「Legado 3.0」后端连接书架。",
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "打开阅读侧栏"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "toggle-stealth": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "切换摸鱼模式"
    }
  }
}
